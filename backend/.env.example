# Copy this file to backend/.env and fill in your local values.
# Never commit backend/.env.

FLASK_ENV=development
FLASK_PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=civicvoice
DB_PASSWORD=replace-with-your-local-password
DB_NAME=civicvoice
TEST_DB_NAME=civicvoice_test

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: used only by backend/start_mysql.ps1 and stop_mysql.ps1.
# MYSQL_HOME=C:/path/to/mysql-8.4.9-winx64
# MYSQL_INI=C:/path/to/my.ini
# MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
